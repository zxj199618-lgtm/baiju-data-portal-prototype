# 观星台发版配置（复制为 .deploy.env 后填写）
#
#   cp .deploy.env.example .deploy.env
#
# .deploy.env 已在 .gitignore 中，不会被提交；仓库里不保存任何服务器信息。
# 这些变量也可以直接用环境变量传入，环境变量优先级高于本文件。

# 【必填】服务器 SSH 目标，例如 ubuntu@1.2.3.4
DEPLOY_HOST=

# 【必填】服务器上的仓库路径
DEPLOY_PATH=/home/ubuntu/guanxingta

# 线上地址，发版后用于核对静态资源版本号；留空则跳过核对
DEPLOY_URL=https://gxt.lumofyi.com/

# compose 文件（多个用英文逗号分隔，按顺序叠加）
DEPLOY_COMPOSE_FILES=docker-compose.prod.yml,docker-compose.jianguang.yml

# 需要重建的服务名
DEPLOY_SERVICE=analysis-gateway

# docker 调用方式：服务器上 docker 需要 sudo 时保持默认
DEPLOY_DOCKER=sudo -n docker

# ssh 附加参数
DEPLOY_SSH_OPTS=-o BatchMode=yes -o ConnectTimeout=15

# 是否顺带推送到 GitHub（1/0）。推送失败不影响生产发布，只影响 GitHub Pages 的更新时机
DEPLOY_PUSH=1

# 线上版本号核对的重试次数与间隔（秒）
DEPLOY_VERIFY_RETRIES=30
DEPLOY_VERIFY_INTERVAL=10

# 工作区有未提交改动时是否仍继续（1/0）。默认 0，即拒绝发布
DEPLOY_ALLOW_DIRTY=0

# 是否跳过 smoke test（1/0），仅排障时使用
DEPLOY_SKIP_TESTS=0
