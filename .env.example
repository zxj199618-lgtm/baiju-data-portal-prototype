RELAY_API_KEY=sk-中转站Key1,sk-中转站Key2（多个 key 用英文逗号分隔，网关会自动按模型路由）
# 服务器正式部署用（docker-compose.prod.yml）：绑定域名，Caddy 自动申请 HTTPS 证书
DOMAIN=data.example.com

# 登录账号的初始密码（仅首次创建账号时生效；不设置则首次启动随机生成并打印到日志）
PORTAL_INITIAL_PASSWORD=
# 登录令牌签名密钥（不设置则自动生成并保存在数据卷中）
PORTAL_AUTH_SECRET=

# 跨域白名单（逗号分隔）：默认只允许同源页面与本机开发页；写 * 表示不限制（不建议）
PORTAL_ALLOWED_ORIGINS=
# 每人每日分析次数 / token 上限；留空使用默认（200 次 / 200 万 token），0 表示不限；管理员也可在运行时按人调整
PORTAL_DAILY_REQUEST_LIMIT=
PORTAL_DAILY_TOKEN_LIMIT=

# 仅限本机演示：设置后登录页公开显示账号并自动填入这个密码；服务器部署不要设置
# PORTAL_DEMO_LOGIN_PASSWORD=
